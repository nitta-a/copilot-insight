{
  "name": "copilot-insight",
  "displayName": "Copilot Insight",
  "description": "Visualize your GitHub Copilot usage — suggestions shown/accepted and acceptance rate by date.",
  "version": "1.1.1",
  "icon": "images/icon.png",
  "publisher": "nitta-a",
  "repository": {
    "type": "git",
    "url": "https://github.com/nitta-a/copilot-insight"
  },
  "engines": {
    "vscode": "^1.105.0",
    "node": ">=22.22.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilotUsage",
          "title": "Copilot Insight",
          "icon": "images/activity-icon.svg"
        }
      ]
    },
    "views": {
      "copilotUsage": [
        {
          "id": "copilotUsageView",
          "name": "Usage Statistics"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "copilotUsageView",
        "contents": "Show GitHub Copilot usage statistics by language and date.\n[Show Usage](command:copilot-insight.showCopilotUsage)"
      }
    ],
    "commands": [
      {
        "command": "copilot-insight.showCopilotUsage",
        "title": "Copilot Insight: Show Usage",
        "icon": "$(open-preview)"
      },
      {
        "command": "copilot-insight.changeDailyUsagePeriod",
        "title": "Copilot Insight: Change Daily Usage Period"
      },
      {
        "command": "copilot-insight.refreshUsage",
        "title": "Copilot Insight: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "copilot-insight.exportCsv",
        "title": "Copilot Insight: Export CSV",
        "icon": "$(file)"
      },
      {
        "command": "copilot-insight.exportJson",
        "title": "Copilot Insight: Export JSON",
        "icon": "$(json)"
      },
      {
        "command": "copilot-insight.exportReport",
        "title": "Copilot Insight: Export Report (Markdown)",
        "icon": "$(markdown)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "copilot-insight.showCopilotUsage",
          "when": "view == copilotUsageView",
          "group": "navigation"
        },
        {
          "command": "copilot-insight.refreshUsage",
          "when": "view == copilotUsageView",
          "group": "navigation"
        },
        {
          "command": "copilot-insight.exportCsv",
          "when": "view == copilotUsageView",
          "group": "export"
        },
        {
          "command": "copilot-insight.exportJson",
          "when": "view == copilotUsageView",
          "group": "export"
        },
        {
          "command": "copilot-insight.exportReport",
          "when": "view == copilotUsageView",
          "group": "export"
        }
      ],
      "commandPalette": [
        {
          "command": "copilot-insight.changeDailyUsagePeriod",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Copilot Insight",
      "properties": {
        "copilot-insight.maxSessionDirs": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 20,
          "description": "Maximum number of recent VS Code session directories to scan for Copilot logs."
        },
        "copilot-insight.defaultDisplayDays": {
          "type": "integer",
          "default": 14,
          "enum": [7, 14, 30],
          "description": "Default number of days to show in the Daily Usage chart."
        },
        "copilot-insight.enableAdvancedAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "Enable the advanced analysis worker for deep metrics (true acceptance rate, velocity, model performance). When disabled, raw JSONL event logging continues but the metrics dashboard is unavailable."
        },
        "copilot-insight.cliLogPath": {
          "type": "string",
          "default": "",
          "description": "Path to the GitHub Copilot CLI session-state directory. Leave empty for automatic discovery (~/.copilot/session-state)."
        },
        "copilot-insight.cliRoiMinutesPerInteraction": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 120,
          "description": "Estimated minutes saved per GitHub Copilot CLI interaction (used for ROI calculation)."
        },
        "copilot-insight.cliDefaultModel": {
          "type": "string",
          "default": "Copilot CLI",
          "description": "Fallback model name label for GitHub Copilot CLI interactions when a model name cannot be detected from the CLI log (e.g. 'claude-opus-4.6')."
        },
        "copilot-insight.enableTimingLogs": {
          "type": "boolean",
          "default": false,
          "description": "Output detailed [TIMING] diagnostic logs to the Output panel during log parsing. Enabling this adds per-file overhead and is intended for troubleshooting slow parses only."
        }
      }
    },
    "mcpServers": {
      "copilot-insight": {
        "command": "node",
        "args": ["${extensionPath}/bin/mcp-server.js", "--storage", "${globalStoragePath}"]
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "postinstall": "npm run build:native || true",
    "compile": "(npm run build:native || true) && npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run build:native && npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "biome lint ./src ./test",
    "lint:fix": "biome lint --write ./src ./test",
    "format": "biome format ./src ./test",
    "format:fix": "biome format --write ./src ./test",
    "test": "vscode-test",
    "vsce:pre-package": "vsce package --pre-release --no-dependencies",
    "vsce:package": "vsce package",
    "vsce:pre-publish": "vsce publish --pre-release --no-dependencies",
    "vsce:publish": "vsce publish",
    "in": "code --install-extension ",
    "p": "npm run package && npm run vsce:package",
    "build:native": "cd native-parser && napi build --platform --release --js index.js --dts index.d.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@napi-rs/cli": "^3.5.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.x",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "1.105.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.4",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "chart.js": "^4.5.1",
    "html2canvas": "^1.4.1",
    "lit": "^3.3.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0"
  },
  "overrides": {
    "diff": ">8.0.2",
    "express-rate-limit": ">8.2.1",
    "hono": ">=4.12.7",
    "undici": ">=7.23.0",
    "@hono/node-server": ">=1.19.10",
    "serialize-javascript": ">7.0.2"
  }
}
