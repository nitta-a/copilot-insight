{
  "name": "copilot-insight",
  "displayName": "Copilot Insight",
  "description": "Visualize your GitHub Copilot usage — suggestions shown/accepted and acceptance rate by language and date.",
  "version": "1.0.1",
  "icon": "images/icon.png",
  "publisher": "nitta-a",
  "repository": {
    "type": "git",
    "url": "https://github.com/nitta-a/plugin-draft"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilotUsage",
          "title": "Copilot Insight",
          "icon": "images/activity-icon.svg"
        }
      ]
    },
    "views": {
      "copilotUsage": [
        {
          "id": "copilotUsageView",
          "name": "Usage Statistics"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "copilotUsageView",
        "contents": "Show GitHub Copilot usage statistics by language and date.\n[Show Usage](command:copilot-insight.showCopilotUsage)"
      }
    ],
    "commands": [
      {
        "command": "copilot-insight.showCopilotUsage",
        "title": "Copilot Insight: Show Usage",
        "icon": "$(open-preview)"
      },
      {
        "command": "copilot-insight.changeDailyUsagePeriod",
        "title": "Copilot Insight: Change Daily Usage Period"
      },
      {
        "command": "copilot-insight.refreshUsage",
        "title": "Copilot Insight: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "copilot-insight.exportCsv",
        "title": "Copilot Insight: Export CSV",
        "icon": "$(file)"
      },
      {
        "command": "copilot-insight.exportJson",
        "title": "Copilot Insight: Export JSON",
        "icon": "$(json)"
      },
      {
        "command": "copilot-insight.exportReport",
        "title": "Copilot Insight: Export Report (Markdown)",
        "icon": "$(markdown)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "copilot-insight.showCopilotUsage",
          "when": "view == copilotUsageView",
          "group": "navigation"
        },
        {
          "command": "copilot-insight.refreshUsage",
          "when": "view == copilotUsageView",
          "group": "navigation"
        },
        {
          "command": "copilot-insight.exportCsv",
          "when": "view == copilotUsageView",
          "group": "export"
        },
        {
          "command": "copilot-insight.exportJson",
          "when": "view == copilotUsageView",
          "group": "export"
        },
        {
          "command": "copilot-insight.exportReport",
          "when": "view == copilotUsageView",
          "group": "export"
        }
      ],
      "commandPalette": [
        {
          "command": "copilot-insight.changeDailyUsagePeriod",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Copilot Insight",
      "properties": {
        "copilot-insight.maxSessionDirs": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "description": "Maximum number of recent VS Code session directories to scan for Copilot logs."
        },
        "copilot-insight.defaultDisplayDays": {
          "type": "integer",
          "default": 14,
          "enum": [
            7,
            14,
            30
          ],
          "description": "Default number of days to show in the Daily Usage chart."
        },
        "copilot-insight.topLanguagesCount": {
          "type": "integer",
          "default": 10,
          "minimum": 3,
          "maximum": 30,
          "description": "Number of top languages to display in the Usage by Language chart."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "biome lint ./src ./test",
    "lint:fix": "biome lint --write ./src ./test",
    "format": "biome format ./src ./test",
    "format:fix": "biome format --write ./src ./test",
    "test": "vscode-test",
    "vsce:pre-package": "vsce package --pre-release --no-dependencies",
    "vsce:package": "vsce package",
    "vsce:pre-publish": "vsce publish --pre-release --no-dependencies",
    "vsce:publish": "vsce publish",
    "inext": "code --install-extension "
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.x",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  }
}
